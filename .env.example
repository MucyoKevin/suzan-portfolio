# Canonical origin used for canonical links, OG tags, sitemap.xml and JSON-LD.
# Leave unset on Vercel to fall back to the project's production URL; set it as
# soon as a custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://suzan-portfolio.vercel.app

# Optional. Paste the token from Google Search Console ("HTML tag" method) to
# emit <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Same, for Bing Webmaster Tools (<meta name="msvalidate.01">).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
